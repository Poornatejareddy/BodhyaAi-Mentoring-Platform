# Environment Variables Template
# Copy this to .env and fill in your actual values

# Database
MONGODB_URI=mongodb://localhost:27017/bodhyaai
MONGODB_TEST_URI=mongodb://localhost:27017/bodhyaai-test

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# AI Services
COG_SERVICE_URL=http://localhost:8001
RISK_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003
XAI_SERVICE_URL=http://localhost:8004

# Email Configuration (Optional - for sending survey links)
# For Gmail: You need to create an App Password
# 1. Go to Google Account Settings > Security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords and create one for "Mail"
# 4. Use the 16-character password below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Alternative: SendGrid (100 free emails/day)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key
