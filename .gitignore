# Version Control Ignores

# Python Caches & Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node Packages & Builds
node_modules/
npm-debug.log
yarn-error.log
dist/
build/
coverage/

# Transient Process & Runtime Directories
logs/
.pids/

# Environments
.env
.env.*
!.env.example

# Operating System Files
.DS_Store
Thumbs.db
*.gguf
