# ==============================================================================
# BODHYAAI ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------------------------
# Connection string for your MongoDB instance or MongoDB Atlas cluster.
MONGODB_URI=mongodb://localhost:27017/bodhyai
# Connection string for running test suites.
MONGODB_TEST_URI=mongodb://localhost:27017/bodhyai-test

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT
# ------------------------------------------------------------------------------
# Cryptographically secure secret key used to sign JSON Web Tokens.
JWT_SECRET=replace-this-with-a-secure-64-character-random-key
# Token duration before expiration (e.g. 7 days '7d', 1 hour '1h').
JWT_EXPIRE=7d

# ------------------------------------------------------------------------------
# 3. NODE.JS SERVER
# ------------------------------------------------------------------------------
# Active port for the Express backend server (default: 5001).
PORT=5001
# Runtime environment ('development' or 'production').
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. FRONTEND MAPPING
# ------------------------------------------------------------------------------
# Public origin of the React client application (used for CORS and email links).
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. AI SERVICES (MICROSERVICES) URLS
# ------------------------------------------------------------------------------
# Cognitive Profiling Service URL (FastAPI)
COG_SERVICE_URL=http://localhost:8000
# Risk Prediction Service URL (FastAPI)
RISK_SERVICE_URL=http://localhost:8001
# Explainable AI (SHAP) Service URL (FastAPI)
XAI_SERVICE_URL=http://localhost:8002
# LLM & RAG Mentoring Assistant Service URL (FastAPI)
LLM_SERVICE_URL=http://localhost:8003

# ------------------------------------------------------------------------------
# 6. EXTERNAL LLM API KEYS
# ------------------------------------------------------------------------------
# Google Gemini API key used by the RAG service.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# SMTP server hostname (e.g. smtp.gmail.com).
EMAIL_HOST=smtp.gmail.com
# Port for secure connection (587 for TLS, 465 for SSL).
EMAIL_PORT=587
# Authentication username for SMTP.
EMAIL_USER=your-email@gmail.com
# Authentication password (use App Passwords for Gmail).
EMAIL_PASS=your-smtp-app-password-here
